# OMNISURV-AI Environment Configuration

# Application
APP_NAME=OmniSurv-AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql://omnisurv:omnisurv_secure_pass@localhost:5432/omnisurv_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Async Processing
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cctv_crops_clip_vit_b32
QDRANT_VECTOR_DIM=512
QDRANT_DISTANCE_METRIC=Cosine

# Computer Vision & Models
MODEL_PATH=./ml/weights
YOLO_MODEL=yolov11x.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
BYTE_TRACK_MAX_LOST=30
BYTE_TRACK_MIN_CONF=0.30

# Multimodal Embeddings
CLIP_MODEL_NAME=ViT-B/32
CLIP_ONNX_PATH=./ml/weights/clip_vit_b32.onnx
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Agentic AI & LLM (Configurable Provider)
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-2.5-flash
ANTI_HALLUCINATION_STRICT_MODE=True

# Storage Paths
DATA_DIR=./data
VIDEOS_DIR=./data/videos
FRAMES_DIR=./data/frames
CROPS_DIR=./data/crops
EXPORTS_DIR=./data/exports
